# Copy to .env.local for local runs. Never commit real values.
# Provider mode is explicit. `fixture` is local/offline only; test/prod require
# every Waffo secret, scoped identifier, public key, HTTPS return base, and DB.
WAFFO_MODE=fixture
PUBLIC_BASE_URL=http://localhost:3000
WAFFO_API_BASE=https://api.waffo.ai
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_PRIVATE_KEY_FILE=
WAFFO_STORE_ID=
WAFFO_PRODUCT_ID=
WAFFO_WEBHOOK_TEST_PUBLIC_KEY=
WAFFO_WEBHOOK_PROD_PUBLIC_KEY=

DATABASE_PATH=./data/app.sqlite
